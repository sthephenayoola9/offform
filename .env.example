# OFFFORM Environment Configuration
# Local SQLite default (portable, zero external dependency required for dev):
DATABASE_URL="file:./dev.db"

# MySQL Production Configuration:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/offform"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="replace_with_a_random_secret"

# Payment Provider Test Credentials (mock/sandbox)
PAYMENT_PROVIDER_MODE="mock"
PAYMENT_PROVIDER_KEY="replace_with_your_test_provider_key"

NODE_ENV="development"
